/* Catppuccin Mocha for Rofi — default fallback colors */
/* These are overridden by matugen-generated colors.rasi when available */

* {
    /* Default palette (Catppuccin Mocha mapped to Material You names) */
    primary:           #89b4fa;
    on-primary:        #1e1e2e;
    secondary:         #b4befe;
    on-secondary:      #1e1e2e;
    tertiary:          #94e2d5;

    background:        #1e1e2e;
    on-background:     #cdd6f4;

    surface:           #1e1e2e;
    on-surface:        #cdd6f4;
    surface-variant:   #45475a;
    on-surface-variant: #a6adc8;

    surface-container:         #313244;
    surface-container-high:    #45475a;
    surface-container-highest: #585b70;

    outline:           #585b70;
    outline-variant:   #45475a;

    error:             #f38ba8;
    on-error:          #1e1e2e;

    inverse-surface:    #cdd6f4;
    inverse-on-surface: #1e1e2e;
    inverse-primary:    #1e1e2e;

    /* Aliases used in elements */
    bg:        @background;
    bg-alt:    @surface-container;
    fg:        @on-background;
    fg-alt:    @on-surface-variant;
    selected:  @primary;
    active:    @tertiary;
    urgent:    @error;

    background-color: transparent;
    text-color:       @fg;
}

window {
    width:            600px;
    border-radius:    16px;
    border:           2px solid;
    border-color:     @selected;
    background-color: @bg;
    padding:          0;
}

mainbox {
    padding:  12px;
    spacing:  12px;
}

inputbar {
    padding:          10px 16px;
    border-radius:    12px;
    background-color: @bg-alt;
    spacing:          8px;
    children:         [ prompt, entry ];
}

prompt {
    background-color: inherit;
    text-color:       @selected;
}

entry {
    background-color: inherit;
    placeholder:      "Search...";
    placeholder-color: @fg-alt;
}

listbox {
    spacing: 4px;
}

listview {
    lines:    10;
    columns:  1;
    fixed-height: true;
    spacing:  4px;
    scrollbar: false;
}

element {
    padding:       8px 12px;
    border-radius: 10px;
    spacing:       8px;
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg;
}

element selected.normal {
    background-color: @selected;
    text-color:       @on-primary;
}

element normal.active {
    text-color: @active;
}

element selected.active {
    background-color: @active;
    text-color:       @on-primary;
}

element normal.urgent {
    text-color: @urgent;
}

element selected.urgent {
    background-color: @urgent;
    text-color:       @on-error;
}

element-icon {
    size:             24px;
    background-color: inherit;
}

element-text {
    background-color: inherit;
    text-color:       inherit;
    vertical-align:   0.5;
}

message {
    padding:          8px 12px;
    border-radius:    10px;
    background-color: @bg-alt;
}

textbox {
    background-color: inherit;
}
