/* Rofi layout. Colors come from the active desktop theme. */
@import "colors.rasi"

* {
    font:             "JetBrains Mono 14";
    background-color: transparent;
    text-color:       @fg;
}

window {
    width:            600px;
    border-radius:    16px;
    border:           2px solid;
    border-color:     @selected;
    background-color: @bg;
    padding:          0;
}

mainbox {
    padding:  12px;
    spacing:  12px;
}

inputbar {
    padding:          10px 16px;
    border-radius:    12px;
    background-color: @bg-alt;
    spacing:          8px;
    children:         [ prompt, entry ];
}

prompt {
    background-color: inherit;
    text-color:       @selected;
}

entry {
    background-color: inherit;
    placeholder:      "Search...";
    placeholder-color: @fg-alt;
}

listbox {
    spacing: 4px;
}

listview {
    lines:    10;
    columns:  1;
    fixed-height: true;
    spacing:  4px;
    scrollbar: false;
}

element {
    padding:       8px 12px;
    border-radius: 10px;
    spacing:       8px;
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg;
}

element selected.normal {
    background-color: @selected;
    text-color:       @on-primary;
}

element normal.active {
    text-color: @active;
}

element selected.active {
    background-color: @active;
    text-color:       @on-primary;
}

element normal.urgent {
    text-color: @urgent;
}

element selected.urgent {
    background-color: @urgent;
    text-color:       @on-error;
}

element-icon {
    size:             24px;
    background-color: inherit;
}

element-text {
    background-color: inherit;
    text-color:       inherit;
    vertical-align:   0.5;
}

message {
    padding:          8px 12px;
    border-radius:    10px;
    background-color: @bg-alt;
}

textbox {
    background-color: inherit;
}
